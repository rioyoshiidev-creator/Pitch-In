{
  "expo": {
    "name": "Pitch-In",
    "slug": "pitch-in",
    "scheme": "pitchin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pitchin.app",
      "buildNumber": "4",
      "minimumOsVersion": "26.1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "NSUserNotificationUsageDescription": "試合開始・選手出場時にアラームで知らせます",
        "NSAlarmKitUsageDescription": "試合開始・選手出場時にアラームで起こします",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pitchin.pitchin"
        ]
      },
      "appleTeamId": "9FW877MVVZ"
    },
    "plugins": [],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0a5b579-393a-4bec-bc09-87379a2a2172"
      }
    },
    "owner": "rioyoshii"
  }
}
